			<artifactId>reactor-test</artifactId>
			<version>3.8.3</version>
			<scope>test</scope>
		</dependency>
		-->
	</dependencies>

	<repositories>
		<repository>
			<id>spring-snapshots</id>
			<name>Spring Snapshots</name>
			<url>https://repo.spring.io/snapshot</url>
			<releases>
				<enabled>false</enabled>
			</releases>
		</repository>
	</repositories>

</project>
